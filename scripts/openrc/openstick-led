#!/sbin/openrc-run
name="OpenStick saved notification LED settings"

depend() {
    need localmount
    after networkmanager
}

start() {
    ebegin "Applying saved OpenStick LED settings"
    cd /opt/openstick || return 1
    /usr/bin/python3 -m uz801_manager.leds
    eend $?
}

stop() {
    # This is an apply-on-boot task, not a background LED process.
    return 0
}
